# ---------------------------------------------------------------------------
# svd-connect-server configuration
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# HTTP / WebSocket listener
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Room lifecycle
ROOM_TTL_MINUTES=30
MAX_PLAYERS_PER_ROOM=8
CLEANUP_INTERVAL_SECONDS=30

# Rate limiting / anti-abuse
MAX_ROOMS_PER_IP_WINDOW=5
ROOM_CREATION_WINDOW_MINUTES=10
MAX_CONNECTIONS_PER_IP=10
MAX_FAILED_JOIN_ATTEMPTS=5
FAILED_JOIN_LOCKOUT_MINUTES=5
MAX_INVALID_MESSAGES_PER_CONNECTION=5

# Message limits
MAX_MESSAGE_SIZE_BYTES=65536
MAX_SDP_LENGTH=32768
MAX_ICE_CANDIDATE_LENGTH=1024

# Connection health
HEARTBEAT_INTERVAL_SECONDS=30

# Logging: error | warn | info | debug | trace
LOG_LEVEL=info
# Set to true to emit newline-delimited JSON logs (default: true when NODE_ENV=production)
LOG_JSON=

# Security
# Comma separated Origin allowlist. Empty = allow any Origin.
# Native clients (the SMAPI mod) do not send an Origin header and are always allowed.
ALLOWED_ORIGINS=
# Set to true when running behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=false
# Reject plaintext (ws://) upgrades when NODE_ENV=production. Requires TRUST_PROXY or TLS_*.
REQUIRE_SECURE_TRANSPORT=true

# Optional built-in TLS (otherwise terminate TLS at a reverse proxy such as nginx/Caddy)
TLS_CERT_PATH=
TLS_KEY_PATH=

# Observability
METRICS_ENABLED=true
