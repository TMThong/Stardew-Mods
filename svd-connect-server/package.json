{
  "name": "svd-connect-server",
  "version": "0.1.0",
  "description": "Signaling server for the Stardew Connect peer-to-peer multiplayer mod.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/finish-cjs-build.mjs",
    "start": "node dist/index.js",
    "start:cjs": "node dist-cjs/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "manual-test": "node scripts/manual-test.mjs"
  },
  "keywords": [
    "stardew-valley",
    "webrtc",
    "signaling",
    "websocket"
  ],
  "author": "Tran Minh Thong",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
